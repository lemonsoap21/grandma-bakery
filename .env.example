# Server
PORT=4000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/daniel

# Price data (Open Prices requires no API key for reading)
OPEN_PRICES_BASE_URL=https://prices.openfoodfacts.org/api

# Shelf life and price category lookup for new ingredients (optional; without it a 7-day
# default is used and prices fall back to sample stores)
ANTHROPIC_API_KEY=

# Ordering mode: "mock" simulates purchases and delivery
SUPPLIER_MODE=mock

# Timing: aim to have ingredients arrive this many hours before baking starts
ORDER_SAFETY_BUFFER_HOURS=24
SCHEDULER_CRON=*/5 * * * *

# Bakery delivery address
BAKERY_DELIVERY_ADDRESS=your_bakery_address_here
