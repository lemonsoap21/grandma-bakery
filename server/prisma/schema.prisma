generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Quantities and prices are always in the ingredient's base unit: g, ml or each.
model Ingredient {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  unit              String
  shelfLifeHours    Int                @default(168)
  categoryTag       String? // Open Food Facts category, e.g. "en:butters"
  fallbackPrice     Float // price per base unit used when Open Prices has no data
  recipeIngredients RecipeIngredient[]
  prices            Price[]
  purchases         Purchase[]
}

model MenuItem {
  id           Int                @id @default(autoincrement())
  name         String             @unique
  instructions String             @default("")
  batchSize    Int                @default(1) // pieces one run of the recipe makes; ingredient quantities are per run
  batchUnit    String             @default("batch") // what a piece is called, e.g. "cookies"
  prepMinutes  Int
  bakeMinutes  Int
  ingredients  RecipeIngredient[]
  orderItems   OrderItem[]
}

model RecipeIngredient {
  id           Int        @id @default(autoincrement())
  menuItemId   Int
  ingredientId Int
  quantity     Float // per batch/unit of the menu item
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([menuItemId, ingredientId])
}

model Order {
  id           Int         @id @default(autoincrement())
  customerName String
  deliveryAt   DateTime
  status       String      @default("OPEN") // OPEN | CANCELLED
  createdAt    DateTime    @default(now())
  items        OrderItem[]
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  menuItemId Int
  quantity   Int
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
}

model Supplier {
  id            Int        @id @default(autoincrement())
  key           String     @unique // "osm:node:123" or "fallback:sample-mart"
  name          String
  address       String?
  leadTimeHours Int // simulated
  prices        Price[]
  purchases     Purchase[]
  cartRuns      CartRun[]
}

model Price {
  id           Int        @id @default(autoincrement())
  ingredientId Int
  supplierId   Int
  pricePerUnit Float
  currency     String     @default("CAD")
  source       String // web_search | fallback
  url          String? // page the price was found on (web_search only)
  packageInfo  String? // what was priced, e.g. "Five Roses All Purpose Flour, 2.5 kg for $4.47"
  packageSize  Float? // base units (g, ml or each) in one package
  packagePrice Float? // price of one package
  observedAt   DateTime
  fetchedAt    DateTime   @default(now())
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  supplier     Supplier   @relation(fields: [supplierId], references: [id])

  @@unique([ingredientId, supplierId])
}

model Purchase {
  id             Int        @id @default(autoincrement())
  ingredientId   Int
  supplierId     Int
  quantity       Float
  unitPrice      Float
  totalCost      Float
  currency       String
  orderAt        DateTime
  arriveBy       DateTime
  // SCHEDULED → (browser mode) PREPARING → CART_READY | CART_FAILED → PLACED → DELIVERED
  status         String     @default("SCHEDULED")
  orderItemIds   Int[] // order items this delivery covers
  productUrl     String? // exact product page to buy from
  packageInfo    String? // e.g. "No Name All-Purpose Flour, 10 kg for $9.88"
  packages       Int? // how many packages to buy
  cartRunId      Int?
  confirmationId String?
  placedAt       DateTime?
  createdAt      DateTime   @default(now())
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id])
  supplier       Supplier   @relation(fields: [supplierId], references: [id])
  cartRun        CartRun?   @relation(fields: [cartRunId], references: [id])
}

// One browser-agent run that fills a store cart for the purchases due there. The agent never
// checks out; the baker places the order and records the confirmation number.
model CartRun {
  id             Int        @id @default(autoincrement())
  supplierId     Int
  status         String     @default("RUNNING") // RUNNING | READY | FAILED | ORDERED | DISMISSED
  summary        String     @default("")
  items          Json? // what the agent reports it put in the cart
  cartUrl        String?
  cartTotal      Float?
  screenshot     String? // file name under server/agent-screenshots
  steps          Int        @default(0)
  confirmationId String?
  startedAt      DateTime   @default(now())
  finishedAt     DateTime?
  orderedAt      DateTime?
  supplier       Supplier   @relation(fields: [supplierId], references: [id])
  purchases      Purchase[]
}
